{
  "permissions": {
    "allow": [
      "Bash(codex --version)",
      "Bash(codex login status)",
      "Bash(codex exec --help)",
      "Bash(bash ~/.claude/skills/delegate/delegate-run.sh *)",
      "Bash(pwd -P)",
      "Bash(mkdir -p .ai*)",
      "Bash(date +%Y%m%d-%H%M)",
      "Bash(git rev-parse *)",
      "Bash(git branch --show-current)",
      "Bash(git status *)",
      "Bash(git switch -c ai/*)",
      "Bash(git add -N .)",
      "Bash(git add -A)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git log *)",
      "Bash(git commit -m *)",
      "Bash(pgrep -fl *)",
      "Edit(.ai/**)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(* --dangerously-bypass-approvals-and-sandbox*)",
      "Bash(* --yolo*)",
      "Bash(* danger-full-access*)",
      "Edit(.ai/*/runs.log)"
    ]
  },
  "env": {
    "BASH_MAX_TIMEOUT_MS": "1800000"
  }
}
